{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build com Make - Rick Dangerous",
            "command": "make",
            "args": [
                "all"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila o projeto Rick Dangerous usando Makefile."
        },
        {
            "type": "shell",
            "label": "Limpar Projeto (Make)",
            "command": "make",
            "args": [
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "clean",
            "detail": "Limpa os arquivos de build gerados pelo Makefile."
        }
    ]
}